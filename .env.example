# Copy to .env and fill in your values.

# CLI defaults
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# PriceAI web integration
PRICEAI_DETECTOR_CORS_ORIGINS=https://priceai.cc,https://www.priceai.cc,http://localhost:3000,http://127.0.0.1:3000
VERIDROP_JOBS_DIR=.local-data/jobs

# Cloudflare Turnstile.
# Local development can leave these blank. Production should set the secret and
# usually set PRICEAI_TURNSTILE_REQUIRED=true.
PRICEAI_TURNSTILE_REQUIRED=false
PRICEAI_TURNSTILE_SECRET_KEY=
